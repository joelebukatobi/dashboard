{
  "name": "blogcms-admin",
  "version": "1.0.0",
  "description": "BlogCMS Admin Dashboard - Fastify backend with HTMX",
  "type": "module",
  "scripts": {
    "deps:approve": "allow-scripts",
    "start": "node app.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run watch:css\"",
    "dev:server": "nodemon app.js",
    "build:css": "npx sass scss/admin/main.scss .build/admin.css --no-source-map && npx sass scss/app/main.scss .build/app.css --no-source-map && npx postcss css/index.css -o dist/css/admin.css && npx postcss css/app.css -o dist/css/app.css",
    "build:js": "node scripts/build-js.js",
    "watch:css": "chokidar 'scss/**/*.scss' 'css/**/*.css' 'src/**/*.html' 'src/**/*.js' -c 'npm run build:css' --initial",
    "db:generate": "drizzle-kit generate",
    "db:generate:project": "drizzle-kit generate --config drizzle.project.config.js",
    "db:migrate": "node scripts/migrate.js",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/seed.js",
    "db:seed:fresh": "node scripts/seed.js --fresh",
    "db:reset": "npm run db:migrate && npm run db:seed:fresh",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke",
    "check": "node scripts/check.js && vitest run",
    "test:e2e": "playwright test",
    "db:test": "node scripts/cli.js db test",
    "setup:token": "node scripts/cli.js setup-token",
    "simulate:day": "node scripts/cli.js analytics day",
    "simulate:days": "node scripts/cli.js analytics day --days=90 --backdate",
    "media:thumbs": "node scripts/cli.js media thumbnails"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "alpinejs": "^3.15.12",
    "bcryptjs": "^3.0.3",
    "ckeditor5": "^49.1.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-html": "^0.7.1",
    "fluent-ffmpeg": "^2.1.3",
    "htmx.org": "^2.0.10",
    "lucide": "^1.28.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.5.0",
    "otplib": "^13.4.1",
    "pino": "^10.4.0",
    "preline": "^5.1.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "slugify": "^1.6.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^3.0.1",
    "@playwright/test": "^1.45.3",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.1",
    "node-cron": "^4.6.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^12.0.0",
    "postcss-nesting": "^14.0.0",
    "sass": "^1.77.8",
    "tailwindcss": "^4.1.18",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "blog",
    "cms",
    "fastify",
    "htmx",
    "drizzle",
    "mysql"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "lavamoat": {
    "allowScripts": {
      "drizzle-kit>@esbuild-kit/esm-loader>@esbuild-kit/core-utils>esbuild#0.18.20": true,
      "drizzle-kit>esbuild#0.25.12": true,
      "esbuild#0.28.2": true,
      "sass>@parcel/watcher#2.6.0": true,
      "@lavamoat/preinstall-always-fail#3.0.1": false
    }
  }
}
