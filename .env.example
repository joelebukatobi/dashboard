# Local development configuration. Copy to .env.local and edit.
# Hosted environments set these in the host's own environment panel
# (cPanel "Setup Node.js App"), not in a file.

# development on your machine; production on every hosted box, staging
# included. The app treats anything other than 'production' as development
# and disables helmet, CSP, rate limiting and idle session expiry.
NODE_ENV=development
PORT=7000
HOST=localhost
LOG_LEVEL=debug

# Database
DATABASE_URL=mysql://root:password@localhost:3306/blogcms_dev

# Signs session tokens and encrypts stored settings such as the SMTP
# password. The app refuses to start in production unless this is set.
JWT_SECRET=dev-jwt-secret-key-change-in-production-min-32-characters

# Base URL, used to seed the siteUrl setting and to build the first-launch
# setup link. Optional locally.
APP_URL=http://localhost:7000

# Escape hatch for the guard on scripts that fabricate data (db:seed,
# analytics day/run/scheduler, maintenance update-views). Those refuse to
# run unless NODE_ENV=development, so a stray DATABASE_URL cannot write
# invented traffic to a real database. Only set this if you understand
# which database you are pointed at.
# ALLOW_LOCAL_SIMULATION=true

# SMTP, OAuth and upload limits are configured in the admin Settings page
# and stored in the database, not here.
